    {
        "id": "fn_etat",
        "type": "function",
        "z": "regul",
        "name": "Lecture -> widgets",
        "func": "// Reçoit les coils (topic \"coils\") puis les registres (topic \"registres\") lus dans l'automate\n// et les met en forme pour l'IHM. Une sortie par widget.\nconst a = global.get('adr');\nif (msg.topic === 'coils') { flow.set('co', msg.payload); return null; }\nconst co = flow.get('co');\nif (!co || !a) return null;\nconst hr = msg.payload;\n\nconst signe = v => v > 32767 ? v - 65536 : v;          // entier signé (température)\nconst uHta = hr[a.HR_U_HTA] / 100;\nconst consigne = hr[a.HR_CONSIGNE] / 100;\nconst bandeMorte = hr[a.HR_BANDE_MORTE] / 100;\nconst haut = consigne * (1 + bandeMorte / 100);\nconst bas = consigne * (1 - bandeMorte / 100);\n\n// Date et heure simulées\nconst cumul = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334, 365];\nconst noms = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];\nconst jour = hr[a.HR_JOUR];\nlet m = 0;\nwhile (m < 11 && jour > cumul[m + 1]) m++;\nconst minutes = hr[a.HR_HEURE];\nconst deuxChiffres = n => String(n).padStart(2, '0');\n\nconst etat = {\n    t: Date.now(),\n    uHta, consigne, bas, haut,\n    uHtb: hr[a.HR_U_HTB] / 10,\n    charge: hr[a.HR_I_CHARGE],\n    temperature: signe(hr[a.HR_TEMPERATURE]) / 10,\n    date: (jour - cumul[m]) + ' ' + noms[m],\n    heure: deuxChiffres(Math.floor(minutes / 60)) + ':' + deuxChiffres(minutes % 60),\n    prise: hr[a.HR_PRISE],\n    etape: hr[a.HR_ETAPE],\n    tempsRestant: hr[a.HR_TEMPS_RESTANT],\n    nbManoeuvres: hr[a.HR_NB_MANOEUVRES],\n    motDeVie: hr[a.HR_MOT_DE_VIE],\n    modeAuto: co[a.CO_MODE_AUTO],\n    enManoeuvre: co[a.CO_MANOEUVRE_EN_COURS],\n    defaut: co[a.CO_DEFAUT_REGLEUR],\n    blocage: co[a.CO_BLOCAGE],\n    butee: co[a.CO_BUTEE]\n};\n\n// Les widgets de réglage ne reçoivent une valeur que si elle a changé\n// (sinon on écraserait ce que l'opérateur est en train de taper)\nconst dernier = context.get('dernier') || {};\ncontext.set('dernier', dernier);\nconst siChange = (cle, valeur) => {\n    if (dernier[cle] === valeur) return null;\n    dernier[cle] = valeur;\n    return { payload: valeur };\n};\n\nreturn [\n    { payload: etat },                                             // 0 tableau d'état\n    { payload: uHta },                                             // 1 jauge\n    [{ topic: 'U HTA', payload: uHta },                            // 2 courbe de tension\n     { topic: 'Bande haute', payload: haut },\n     { topic: 'Bande basse', payload: bas }],\n    { topic: 'Prise', payload: etat.prise },                       // 3 courbe de prise\n    siChange('auto', co[a.CO_MODE_AUTO]),                          // 4 interrupteur AUTO / MANUEL\n    siChange('vie', co[a.CO_VARIATIONS_AUTO]),                     // 5 interrupteur vie réelle\n    siChange('consigne', consigne),                                // 6 à 9 réglages\n    siChange('bande', bandeMorte),\n    siChange('tempo1', hr[a.HR_TEMPO_1]),\n    siChange('tempo2', hr[a.HR_TEMPO_2]),\n    siChange('htb', etat.uHtb),                                    // 10 à 12 curseurs\n    siChange('charge', etat.charge),\n    siChange('jour', jour)\n];",
        "outputs": 13,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 170,
        "wires": [
            [
                "tpl_etat"
            ],
            [
                "jauge_u"
            ],
