        "z": "regul",
        "name": "Écrire dans l'automate",
        "showStatusActivities": true,
        "showErrors": true,
        "showWarnings": true,
        "server": "modbus_automate",
        "emptyMsgOnFail": false,
        "keepMsgProperties": false,
        "delayOnStart": false,
        "startDelayTime": "",
        "x": 1370,
