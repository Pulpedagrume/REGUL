                "num_tempo1"
            ],
            [
                "num_tempo2"
            ],
            [
                "sl_htb"
            ],
            [
                "sl_charge"
            ],
            [
                "sl_jour"
            ]
        ]
    },
    {
        "id": "fn_ecrire",
        "type": "function",
        "z": "regul",
        "name": "Widget -> Modbus",
        "func": "// Transforme l'action d'un widget (msg.topic) en écriture Modbus dans l'automate.\n// fc 5 = écrire 1 coil, fc 6 = écrire 1 registre. Le 3e nombre est l'échelle (valeur Modbus = valeur x échelle).\nconst a = global.get('adr');\nconst T = {\n    mode:     [5, a.CO_MODE_AUTO],\n    vie:      [5, a.CO_VARIATIONS_AUTO],\n    plus:     [5, a.CO_BP_PLUS],\n    moins:    [5, a.CO_BP_MOINS],\n    acquit:   [5, a.CO_ACQUITTEMENT],\n    consigne: [6, a.HR_CONSIGNE, 100],\n    bande:    [6, a.HR_BANDE_MORTE, 100],\n    tempo1:   [6, a.HR_TEMPO_1, 1],\n    tempo2:   [6, a.HR_TEMPO_2, 1],\n    htb:      [6, a.HR_U_HTB, 10],\n    charge:   [6, a.HR_I_CHARGE, 1],\n    jour:     [6, a.HR_JOUR, 1]\n};\nconst t = T[msg.topic];\nif (!t) return null;\nconst valeur = t[0] === 5 ? !!msg.payload\n                          : Math.max(0, Math.min(65535, Math.round(Number(msg.payload) * t[2])));\nreturn { payload: { fc: t[0], address: t[1], value: valeur, quantity: 1, unitid: 1 } };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1150,
        "y": 400,
        "wires": [
            [
                "ecrire"
            ]
        ]
    },
    {
        "id": "ecrire",
        "type": "modbus-flex-write",
        "z": "regul",
        "name": "Écrire dans l'automate",
        "showStatusActivities": true,
        "showErrors": true,
        "showWarnings": true,
        "server": "modbus_automate",
        "emptyMsgOnFail": false,
        "keepMsgProperties": false,
