        "type": "function",
        "z": "regul",
        "name": "Table des adresses",
        "func": "// Copie de mapping.py : les mêmes adresses côté IHM.\n// Si vous changez mapping.py, changez aussi ce tableau.\nglobal.set('adr', {\n    // Coils\n    CO_ORDRE_MONTER: 0,\n    CO_ORDRE_DESCENDRE: 1,\n    CO_MANOEUVRE_EN_COURS: 2,\n    CO_MODE_AUTO: 3,\n    CO_BP_PLUS: 4,\n    CO_BP_MOINS: 5,\n    CO_ACQUITTEMENT: 6,\n    CO_DEFAUT_REGLEUR: 7,\n    CO_BLOCAGE: 8,\n    CO_BUTEE: 9,\n    CO_VARIATIONS_AUTO: 10,\n    // Holding registers\n    HR_U_HTA: 0,        // kV x 100\n    HR_PRISE: 1,\n    HR_U_HTB: 2,        // kV x 10\n    HR_I_CHARGE: 3,     // A\n    HR_TEMPERATURE: 4,  // °C x 10, entier signé\n    HR_HEURE: 5,        // minutes depuis minuit\n    HR_JOUR: 6,         // jour de l'année\n    HR_CONSIGNE: 10,    // kV x 100\n    HR_BANDE_MORTE: 11, // % x 100\n    HR_TEMPO_1: 12,     // s\n    HR_TEMPO_2: 13,     // s\n    HR_ETAPE: 20,\n    HR_TEMPS_RESTANT: 21,\n    HR_NB_MANOEUVRES: 22,\n    HR_MOT_DE_VIE: 23\n});\nreturn null;",
        "outputs": 1,
